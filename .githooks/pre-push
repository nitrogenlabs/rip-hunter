#!/bin/sh
set -e

remote=${1:-origin}
zero=0000000000000000000000000000000000000000
needs_test=0
observed=0
while read -r local_ref local_sha remote_ref remote_sha; do
  observed=1
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  base=$remote_sha
  if [ "$remote_sha" = "$zero" ]; then
    default_ref=$(git symbolic-ref --quiet "refs/remotes/$remote/HEAD" 2>/dev/null || true)
    if [ -z "$default_ref" ]; then
      default_ref=refs/heads/main
    fi
    if ! base=$(git merge-base "$local_sha" "$default_ref" 2>/dev/null); then
      needs_test=1
      break
    fi
  fi
  if changes=$(git log --full-history -m --format=%H --no-renames "$base..$local_sha" -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs' '*.mts' '*.cts' '*.css' 2>/dev/null); then
    if [ -n "$changes" ]; then
      needs_test=1
      break
    fi
  else
    needs_test=1
    break
  fi
done
if [ "$observed" -eq 1 ] && [ "$needs_test" -eq 0 ]; then
  exit 0
fi
if ! command -v npm >/dev/null 2>&1 && [ -s "$HOME/.nvm/nvm.sh" ]; then
  . "$HOME/.nvm/nvm.sh"
fi
if ! command -v npm >/dev/null 2>&1; then
  echo "Pre-push end-to-end tests require Node.js and npm." >&2
  exit 127
fi
npm run test:e2e
